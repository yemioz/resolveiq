# Copy this file to .env and fill in real values. Never commit the real .env.

# --- PostgreSQL ---
RESOLVIQ_DB_HOST=localhost
RESOLVIQ_DB_PORT=5432
RESOLVIQ_DB_NAME=resolviq
RESOLVIQ_DB_USER=resolviq
RESOLVIQ_DB_PASSWORD=changeme

# --- Socrata / 311 open data API ---
# NYC: https://data.cityofnewyork.us/resource/erm2-nwe9.json
# Chicago and other cities expose an equivalent Socrata endpoint.
SOCRATA_BASE_URL=https://data.cityofnewyork.us/resource/erm2-nwe9.json
SOCRATA_APP_TOKEN=
SOCRATA_TIMESTAMP_FIELD=updated_at

# --- Power BI (only needed once the refresh step is wired up) ---
POWERBI_WORKSPACE_ID=
POWERBI_DATASET_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_TENANT_ID=

# --- Modeling ---
MODEL_VERSION=0.1.0
SLA_DEFAULT_DAYS=14
